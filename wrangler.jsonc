{
  "name": "workers-rate-limiting-rust",
  "main": "build/index.js",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "build": { "command": "cargo install -q worker-build@0.8.0 && worker-build --release" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "13005", "simple": { "limit": 5, "period": 10 } }]
}
